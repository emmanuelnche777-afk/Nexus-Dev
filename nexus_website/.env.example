# Database (Postgres)
# Get a free Postgres database from one of these providers:
#   Neon:        https://neon.tech        (recommended, free 0.5GB)
#   Supabase:    https://supabase.com     (free 500MB + auth + storage)
#   Railway:     https://railway.app      ($5/mo free credit)
#
# Example Neon connection string:
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# For local development with PostgreSQL:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# AI assistant provider. Use Groq for the local demo and Gemini for the actual
# deployment; set this independently in local .env and the production environment.
# Local demo: AI_PROVIDER=groq and provide GROQ_API_KEY.
# Actual deployment: AI_PROVIDER=gemini and provide GEMINI_API_KEY.
AI_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Cloudinary (image/video uploads)
# Free tier: 25 credits/mo (1 credit = 1GB storage OR 1000 transformations OR 1GB bandwidth)
# Required in production for durable media and private applicant documents.
# Local development can use the local-disk fallback when these are blank.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin bootstrap
# The first Super Admin is created through the UI on first visit to the admin login
# page (no env vars needed). Visit /admin/login and click "First time? Set up your
# admin account" to create the initial Super Admin.
# The old SUPER_ADMIN_EMAIL / SUPER_ADMIN_PASSWORD / SUPER_ADMIN_PHONE pattern is
# fully deprecated and no longer used anywhere in the codebase.

# Encryption key for PII fields (momo payouts, salary, phone, 2FA secrets).
# Must be a 32-byte value, base64-encoded. Generate with:
#   openssl rand -base64 32
ENCRYPTION_KEY=

# Instagram API with Instagram Login (server-side only; never use NEXT_PUBLIC_).
# Copy the Instagram App ID and Instagram App Secret from the Meta app's
# Instagram API with Instagram Login / Business login settings.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_API_VERSION=v26.0

# Scheduler secret sent as Authorization: Bearer <value> to the publishing worker.
CRON_SECRET=

# Public-site URL. Used for public absolute links and CSRF validation.
# Local development defaults to http://localhost:3000 if it is omitted.
NEXUS_URL=http://localhost:3000

# Domain isolation. Set both values in Vercel production before deploying:
# NEXUS_PUBLIC_URL=https://nexus.cm
# NEXUS_ADMIN_URL=https://admin.nexus.cm
# With both set, public visitors receive a 404 for every /admin and /api/admin
# route, and the staff domain serves only the admin area.
NEXUS_PUBLIC_URL=
NEXUS_ADMIN_URL=

# Set to "true" to enable maintenance mode for all non-admin/public routes.
# Admin login, 2FA, forgot/reset, and accept-invite pages remain accessible.
MAINTENANCE_MODE=false

# Notifications (Resend - Email)
# RESEND_API_KEY=<your_resend_api_key>
# EMAIL_FROM_ADDRESS: the sender address Resend uses. Uses Resend's shared testing
# domain onboarding@resend.dev by default — delivers only to the address the Resend
# account was created with. Replace with a verified domain address once you own one.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=onboarding@resend.dev

# Admin alert recipients (fall back to site email/WhatsApp if blank)
ADMIN_NOTIFY_EMAIL=
ADMIN_NOTIFY_WHATSAPP=

# Notifications (Twilio - SMS + WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_FROM=
