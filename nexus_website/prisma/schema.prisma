  academyOverviewVideoUrl    String?
  academyOverviewVideoPublicId String?
}

/// A professional project contract generated for a Tech Hub client.
/// Auto-created from a ServiceOrder; once signed by both parties it is locked
/// (read-only: view / search / retrieve only).
model Contract {
  id                      String        @id @default(cuid())
  orderId                 String?
  clientName              String
  clientEmail             String
  clientPhone             String?
  company                 String?
  serviceType             String
  serviceTypeKey          String
  contractType            String
  templateKey             String        @default("standard-project-agreement")
  bodyTemplate            String
  status                  String        @default("draft")
  totalAmount             Int?
  currency                String        @default("XAF")
  depositPercent          Int?
  depositAmount           Int?
  milestones              String
  scopeText               String?
  bodyText                String
  pdfUrl                  String?
  signedPdfUrl            String?
  signatureClientUrl      String?
  signatureTechHubUrl     String?
  signatureClientAt       DateTime?
  signatureTechHubAt      DateTime?
  signatureToken          String?
  signatureTokenExpiresAt DateTime?
  archivedAt              DateTime?
  sentAt                  DateTime?
  viewedAt                DateTime?
  signedAt                DateTime?
  expiresAt               DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  order                   ServiceOrder? @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@index([clientEmail])
  @@index([contractType])
}

/// A dedicated conversation session between the Tech Hub manager and one client.
/// One session per ServiceOrder; created automatically when the admin starts
/// contacting the client about their order.
model TechHubConversation {
  id            String           @id @default(cuid())
  orderId       String
  subject       String?
  clientName    String
  clientEmail   String
  clientPhone   String?
  company       String?
  serviceType   String
  status        String           @default("open")
  archivedAt    DateTime?
  lastMessageAt DateTime         @updatedAt
  createdAt     DateTime         @default(now())
  order         ServiceOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  messages      TechHubMessage[]

  @@index([orderId])
  @@index([status])
  @@index([archivedAt])
}

/// A single message/note inside a TechHubConversation session.
model TechHubMessage {
  id             String              @id @default(cuid())
  conversationId String
  sender         String
  senderName     String?
  content        String
  isInternal     Boolean             @default(false)
  hasAttachment  Boolean             @default(false)
  channel        String?
  createdAt      DateTime            @default(now())
  conversation   TechHubConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

/// Lifecycle of a public Opportunity listing.
///
/// Replaces the free-text `status` column, which the public feed compared with
/// `status === "open"`: typing `Open` or `CLOSED` silently hid or leaked a
/// listing. `DRAFT` is the default, so a row is never public until an admin
/// explicitly publishes it — an internal sponsorship negotiation left at the
/// old default of "open" could previously appear on /join-us.
enum OpportunityStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum AdminRole {
  SUPER_ADMIN
  ACADEMY_MANAGER
  TECH_HUB_MANAGER
  FOUNDATION_MANAGER
  MENTORSHIP_COORDINATOR
  CONTENT_EDITOR
  SUPPORT_STAFF
  NEWSLETTER_MANAGER
  FINANCE
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum PaymentProvider {
  MTN
  ORANGE
}

enum PathwayInquiryStatus {
  NEW
  REVIEWED
  RESPONDED
}

enum OpportunityApplicationStatus {
  NEW
  UNDER_REVIEW
  MATCHED
  NOT_A_FIT
}
