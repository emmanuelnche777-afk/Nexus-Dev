generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id                          String               @id @default(cuid())
  email                       String               @unique
  name                        String
  active                      Boolean              @default(true)
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  createdBy                   String?
  deletedAt                   DateTime?
  invitedAt                   DateTime?
  invitedTokenExpiresAt       DateTime?
  invitedTokenHash            String?
  momoPayoutName              String?
  momoPayoutNumber            String?
  passwordHash                String?
  passwordResetTokenExpiresAt DateTime?
  passwordResetTokenHash      String?
  phone                       String
  salaryAmount                Decimal?
  salaryCurrency              String?              @default("XAF")
  status                      AdminStatus          @default(ACTIVE)
  twoFactorEnabled            Boolean              @default(false)
  twoFactorSecret             String?
  role                        AdminRole            @default(SUPPORT_STAFF)
  backupCodes                 Json?
  bootstrappedFromIp          String?
  bootstrappedAt              DateTime?
  activityLogs                ActivityLog[]
  receivedMessages            AdminMessage[]       @relation("ReceivedMessages")
  sentMessages                AdminMessage[]       @relation("SentMessages")
  sessions                    AdminSession[]
  notifications               NotificationLog[]
  newsletterCampaigns         NewsletterCampaign[]
  assignedServiceOrders       ServiceOrder[]       @relation("TechHubOrderAssignee")

  @@index([status])
  @@index([deletedAt])
}

model AdminSession {
  id           String    @id @default(cuid())
  userId       String
  token        String    @unique
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  ipAddress    String?
  lastActiveAt DateTime  @default(now())
  userAgent    String?
  user         AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
}

model LoginAttempt {
  id          String   @id @default(cuid())
  identifier  String
  attemptedAt DateTime @default(now())
  success     Boolean
  ipAddress   String?
  userAgent   String?

  @@index([identifier, attemptedAt])
  @@index([attemptedAt])
}

model ApiRateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@id([key, windowStart])
  @@index([windowStart])
}

model AdminMessage {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  recipient   AdminUser @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  sender      AdminUser @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt])
  @@index([senderId, recipientId])
}

model Program {
  id                        String                            @id @default(cuid())
  slug                      String                            @unique
  title                     String
  durationWeeks             Int                               @default(12)
  price                     Int                               @default(0)
  currency                  String                            @default("XAF")
  thumbnailUrl              String?
  shortDescription          String?
  fullDescription           String?
  targetAudience            String?
  certification             String?
  tools                     String[]                          @default([])
  highlights                String[]                          @default([])
  status                    String                            @default("active")
  createdAt                 DateTime                          @default(now())
  updatedAt                 DateTime                          @updatedAt
  awards                    String[]                          @default([])
  curriculumModules         Json                              @default("[]")
  featured                  Boolean                           @default(false)
  instructors               Json                              @default("[]")
  overviewVideoUrl          String?
  overviewVideoPublicId     String?
  requirements              String[]                          @default([])
  cohorts                   Cohort[]
  payments                  Payment[]
  registrations             Registration[]
  students                  Student[]
  privateEnrollmentRequests AcademyPrivateEnrollmentRequest[]

  @@index([status])
  @@index([slug])
}

model AcademyPrivateEnrollmentRequest {
  id                String    @id @default(cuid())
  programSlug       String
  fullName          String
  email             String
  phone             String
  preferredFormat   String
  preferredSchedule String
  message           String?
  status            String    @default("new")
  adminNotes        String?
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  program           Program   @relation(fields: [programSlug], references: [slug], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([programSlug])
  @@index([email])
}

model Cohort {
  id                  String         @id
  programId           String?
  programSlug         String
  name                String
  period              String
  status              String         @default("open")
  startDate           DateTime
  endDate             DateTime
  applicationDeadline DateTime
  maxStudents         Int            @default(30)
  currentStudents     Int            @default(0)
  location            String
  schedule            String
  price               Int            @default(0)
  currency            String         @default("XAF")
  description         String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  program             Program        @relation(fields: [programSlug], references: [slug], onDelete: Cascade)
  registrations       Registration[]
  students            Student[]

  @@index([programSlug])
  @@index([status])
}

model Registration {
  id            String    @id
  programId     String?
  programSlug   String
  cohortId      String?
  fullName      String
  email         String
  phone         String
  pathway       String?
  motivation    String?
  status        String    @default("new")
  certificateId String?   @unique
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  payment       Payment?
  cohort        Cohort?   @relation(fields: [cohortId], references: [id])
  program       Program   @relation(fields: [programSlug], references: [slug], onDelete: Cascade)

  @@index([email])
  @@index([status])
  @@index([programSlug])
}

model Student {
  id                     String                        @id @default(cuid())
  studentCode            String                        @unique
  fullName               String
  email                  String
  phone                  String
  programSlug            String
  cohortId               String?
  registrationDate       DateTime                      @default(now())
  status                 String                        @default("Pending")
  paymentStatus          String                        @default("Pending")
  notes                  String?
  createdBy              String                        @default("public")
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  payments               Payment[]
  program                Program                       @relation(fields: [programSlug], references: [slug], onDelete: Cascade)
  cohort                 Cohort?                       @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  notificationDeliveries AcademyNotificationDelivery[]

  @@index([studentCode])
  @@index([email])
  @@index([cohortId])
}

model AcademyNotificationDelivery {
  id                String    @id @default(cuid())
  studentId         String
  template          String
  channel           String
  recipient         String
  status            String    @default("pending")
  attemptCount      Int       @default(0)
  providerMessageId String?
  error             String?
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  sentById          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  student           Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, template, channel])
  @@index([status, updatedAt])
  @@index([studentId, updatedAt])
}

model Payment {
  id             String          @id @default(cuid())
  studentId      String?
  registrationId String?         @unique
  studentCode    String?
  amount         Int
  currency       String          @default("XAF")
  reference      String?
  status         String          @default("Pending")
  notes          String?
  verifiedBy     String?
  verifiedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  programSlug    String?
  method         PaymentProvider @default(MTN)
  program        Program?        @relation(fields: [programSlug], references: [slug])
  registration   Registration?   @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  student        Student?        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([studentCode])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("general")
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([order])
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String    @default("")
  content     Json      @default("[]")
  contentFr   Json      @default("[]")
  author      String?
  coverImage  String?
  tags        String[]  @default([])
  published   Boolean   @default(true)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  category    String    @default("general")
  categoryFr  String?
  date        String?
  excerptFr   String?
  featured    Boolean   @default(false)
  readingTime String?
  seo         Json?
  titleFr     String?

  @@index([published])
  @@index([slug])
  @@index([category])
}

model JourneyEntry {
  id          String       @id @default(cuid())
  date        String
  title       String
  description String
  fullContent String?
  status      String       @default("live")
  category    String       @default("company")
  priority    Int          @default(5)
  tags        String[]     @default([])
  media       Json         @default("[]")
  projectName String?
  phaseOrder  Int?
  progress    Int?
  outcome     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  socialPosts SocialPost[]

  @@index([category])
  @@index([status])
  @@index([priority])
}

/// A public opportunity listing: something NEXUS is recruiting or advertising,
/// that a member of the public may apply to.
///
/// Internal business-development fields (value, probability, expected value,
/// contact, next steps) live on `Deal` instead. They were previously columns on
/// this same row, which meant one table had to mean both "a job ad" and "a
/// sponsorship negotiation" — and the public feed could not tell them apart.
/// They remain here for now, unused, pending a follow-up migration to drop them.
model Opportunity {
  id            String                   @id @default(cuid())
  title         String
  description   String
  type          String
  location      String?
  url           String?
  deadline      DateTime?
  status        String                   @default("open")
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  assignedTo    String?
  autoCloseDate DateTime?
  category      String                   @default("partnership")
  closedAt      DateTime?
  contactEmail  String?
  contactName   String?
  contactPhone  String?
  expectedValue Int?
  nextSteps     String[]                 @default([])
  notes         String?
  probability   Int?
  source        String                   @default("website")
  tags          String[]                 @default([])
  value         Int?
  /// Authoritative lifecycle. Prefer this over the legacy `status` column.
  lifecycle     OpportunityStatus        @default(DRAFT)
  publishedAt   DateTime?
  deal          Deal?
  applications  OpportunityApplication[]

  @@index([type])
  @@index([lifecycle])
  @@index([createdAt])
}

/// Internal business-development record attached to a public listing: what it is
/// worth, how likely it is, who owns chasing it, and who to call.
///
/// Never published. `app/api/opportunities/route.ts` selects an explicit field
/// list and this model is not part of it, so no field here can reach the public
/// feed.
model Deal {
  id            String       @id @default(cuid())
  opportunityId String?      @unique
  value         Int?
  probability   Int?
  expectedValue Int?
  nextSteps     String[]     @default([])
  tags          String[]     @default([])
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  assignedToId  String?
  notes         String?
  source        String       @default("website")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([assignedToId])
}

/// Public "Join Us" pathway submissions (student / client / volunteer /
/// mentor / partner / investor). Completely separate from the Academy
/// Student/Registration/Payment pipeline and from the legacy
/// PendingApplication table, which is never read by any admin surface.
model PathwayInquiry {
  id              String               @id @default(cuid())
  pathway         String
  fullName        String
  email           String
  phone           String?
  /// Pathway-specific fields. The collected field set differs per pathway, so
  /// these are stored as JSON rather than as one sparse column per field.
  details         Json
  status          PathwayInquiryStatus @default(NEW)
  adminNotes      String?
  responseMessage String?
  respondedAt     DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  ownerAssignedAt DateTime?
  /// Staff member currently responsible. Null means it sits in the shared queue.
  ownerId         String?
  /// When the record entered its current status, for SLA queries.
  stageEnteredAt  DateTime             @default(now())

  @@index([status])
  @@index([pathway])
  @@index([email])
  @@index([createdAt])
  @@index([ownerId, status])
  @@index([status, stageEnteredAt])
}

/// Applications submitted against a single Opportunity listing.
///
/// `onDelete: Restrict` is deliberate. This was `Cascade`, so deleting an
/// Opportunity destroyed every applicant's name, email, phone, message and
/// uploaded-document links with it — one admin click, and the applicant records
/// were unrecoverable while the Cloudinary assets stayed orphaned. Restrict makes
/// the database refuse the delete; the API turns that into a clear error and
/// offers archive instead.
model OpportunityApplication {
  id              String                       @id @default(cuid())
  opportunityId   String
  fullName        String
  email           String
  phone           String?
  message         String?
  /// Cloudinary URLs for uploaded certificates / proof of work.
  documentUrls    String[]                     @default([])
  status          OpportunityApplicationStatus @default(NEW)
  adminNotes      String?
  responseMessage String?
  respondedAt     DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  ownerAssignedAt DateTime?
  /// Staff member currently responsible. Null means it sits in the shared queue.
  ownerId         String?
  /// When the record entered its current status, for SLA queries.
  stageEnteredAt  DateTime                     @default(now())
  opportunity     Opportunity                  @relation(fields: [opportunityId], references: [id])

  @@index([status])
  @@index([opportunityId])
  @@index([email])
  @@index([createdAt])
  @@index([ownerId, status])
  @@index([status, stageEnteredAt])
}

model Service {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  tagline      String?
  description  String
  imageUrl     String?
  iconKey      String   @default("Code2")
  features     String[] @default([])
  deliverables String[] @default([])
  status       String   @default("active")
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([sortOrder])
}

model TechHubFeaturedWork {
  id            String   @id @default(cuid())
  title         String
  titleFr       String?
  category      String
  categoryFr    String?
  description   String
  descriptionFr String?
  features      String[] @default([])
  featuresFr    String[] @default([])
  imageUrl      String
  linkUrl       String   @default("")
  linkType      String   @default("website")
  linkLabel     String?
  linkLabelFr   String?
  status        String   @default("draft")
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, sortOrder])
}

model ServiceOrder {
  id                 String                @id @default(cuid())
  serviceType        String
  serviceTypeKey     String
  clientName         String
  clientEmail        String
  clientPhone        String?
  company            String?
  description        String
  budget             String?
  timeline           String?
  status             String                @default("new")
  priority           String                @default("medium")
  assignedTo         String?
  assignedToId       String?
  notes              String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  desiredTimeline    String?
  quoteAmount        Int?
  quoteCurrency      String                @default("XAF")
  quoteDurationWeeks Int?
  source             String                @default("web")
  contracts          Contract[]
  milestones         Milestone[]
  conversations      TechHubConversation[]
  assignee           AdminUser?            @relation("TechHubOrderAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([serviceTypeKey])
  @@index([clientEmail])
  @@index([assignedToId])
}

model Milestone {
  id          String       @id @default(cuid())
  orderId     String
